# Copy this file to ".env" and fill in real values. Never commit the real ".env" file.

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=False

# File upload limits
MAX_CONTENT_LENGTH_MB=10

# Paths (relative to project root, usually no need to change)
DATABASE_PATH=database/app.db
MODEL_DIR=models

# Scoring weights (must sum to 1.0 across the four components)
SCORE_WEIGHT_SKILLS=0.50
SCORE_WEIGHT_SIMILARITY=0.25
SCORE_WEIGHT_EXPERIENCE=0.15
SCORE_WEIGHT_EDUCATION=0.10
